{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-skill-toolkit/plugins/_schema/marketplace.schema.json",
  "title": "AI Skill Toolkit plugin marketplace",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "interface", "plugins"],
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "policy", "category"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "path"],
            "properties": {
              "source": {
                "type": "string",
                "enum": ["local"]
              },
              "path": {
                "type": "string",
                "pattern": "^\\./plugins/[a-z][a-z0-9-]*[a-z0-9]$"
              }
            }
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["installation", "authentication"],
            "properties": {
              "installation": {
                "type": "string",
                "enum": ["AVAILABLE", "REQUIRED", "DISABLED"]
              },
              "authentication": {
                "type": "string",
                "enum": ["ON_INSTALL", "NONE"]
              }
            }
          },
          "category": {
            "type": "string",
            "enum": ["Engineering", "Research", "Design", "Quality", "Workflow"]
          }
        }
      }
    }
  }
}
