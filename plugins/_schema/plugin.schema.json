{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-skill-toolkit/plugins/_schema/plugin.schema.json",
  "title": "AI Skill Toolkit plugin descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "author", "homepage", "repository", "license", "keywords", "skills", "interface"],
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?(?:\\+[A-Za-z0-9.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 512
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
      }
    },
    "skills": {
      "type": "string",
      "pattern": "^\\./[A-Za-z0-9._/-]+/$"
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "shortDescription",
        "longDescription",
        "developerName",
        "category",
        "capabilities",
        "websiteURL",
        "privacyPolicyURL",
        "termsOfServiceURL",
        "defaultPrompt",
        "brandColor",
        "screenshots"
      ],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "shortDescription": { "type": "string", "minLength": 1, "maxLength": 80 },
        "longDescription": { "type": "string", "minLength": 10, "maxLength": 512 },
        "developerName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "category": {
          "type": "string",
          "enum": ["Engineering", "Research", "Design", "Quality", "Workflow"]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["Interactive", "Read", "Write"]
          }
        },
        "websiteURL": { "type": "string", "format": "uri" },
        "privacyPolicyURL": { "type": "string", "format": "uri" },
        "termsOfServiceURL": { "type": "string", "format": "uri" },
        "defaultPrompt": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2, "maxLength": 120 }
        },
        "brandColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
